<Window x:Class="TenantTaskManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tenant Task Manager"
        Width="800"
        Height="500"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FA">
        <Border Width="420"
                Padding="32"
                Background="White"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Tenant Task Manager"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           TextAlignment="Center" />
                <TextBlock Margin="0,12,0,0"
                           Text="WPF desktop companion is running."
                           FontSize="15"
                           Foreground="#5B6475"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
