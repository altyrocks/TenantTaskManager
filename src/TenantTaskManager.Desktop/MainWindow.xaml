<Window x:Class="TenantTaskManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tenant Task Manager"
        Width="800"
        Height="500"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FA">
        <Border x:Name="LoginPanel"
                Width="420"
                Padding="32"
                Background="White"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Tenant Task Manager"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           TextAlignment="Center" />
                <TextBlock Margin="0,8,0,24"
                           Text="Sign in to view your tenant's tasks."
                           FontSize="15"
                           Foreground="#5B6475"
                           TextAlignment="Center" />

                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Foreground="#172033" />
                <TextBox x:Name="EmailTextBox"
                         Margin="0,6,0,16"
                         Padding="10,8"
                         FontSize="14"
                         Text="user@tenanttask.local" />

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="#172033" />
                <PasswordBox x:Name="PasswordInput"
                             Margin="0,6,0,8"
                             Padding="10,8"
                             FontSize="14" />

                <TextBlock x:Name="MessageTextBlock"
                           Margin="0,4,0,0"
                           Foreground="#A51D2D"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Assertive" />

                <Button x:Name="LoginButton"
                        Margin="0,20,0,0"
                        Padding="12,9"
                        Background="#2457C5"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Content="Sign in"
                        IsDefault="True"
                        Click="LoginButton_Click" />
            </StackPanel>
        </Border>

        <Grid x:Name="TaskPanel"
              Margin="32"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Tasks"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#172033" />
                <TextBlock Margin="0,4,0,0"
                           Text="Your tenant's task list"
                           Foreground="#5B6475" />
            </StackPanel>

            <Grid Grid.Row="1">
                <TextBlock x:Name="EmptyTasksMessage"
                           Text="There are no tasks yet."
                           Foreground="#5B6475"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <ListBox x:Name="TaskList"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16"
                                    Background="White"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#172033"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding CreatedDisplay}"
                                                   FontSize="12"
                                                   Foreground="#5B6475" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Margin="16,0,0,0"
                                            Padding="10,4"
                                            Background="#E7EEFC"
                                            CornerRadius="12"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="12"
                                                   Foreground="#2457C5" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
