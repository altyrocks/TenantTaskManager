<Window x:Class="TenantTaskManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tenant Task Manager"
        Width="800"
        Height="500"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FA">
        <Border Width="420"
                Padding="32"
                Background="White"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Tenant Task Manager"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           TextAlignment="Center" />
                <TextBlock Margin="0,8,0,24"
                           Text="Sign in to view your tenant's tasks."
                           FontSize="15"
                           Foreground="#5B6475"
                           TextAlignment="Center" />

                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Foreground="#172033" />
                <TextBox x:Name="EmailTextBox"
                         Margin="0,6,0,16"
                         Padding="10,8"
                         FontSize="14"
                         Text="user@tenanttask.local" />

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="#172033" />
                <PasswordBox x:Name="PasswordInput"
                             Margin="0,6,0,8"
                             Padding="10,8"
                             FontSize="14" />

                <TextBlock x:Name="MessageTextBlock"
                           Margin="0,4,0,0"
                           Foreground="#A51D2D"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Assertive" />

                <Button x:Name="LoginButton"
                        Margin="0,20,0,0"
                        Padding="12,9"
                        Background="#2457C5"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Content="Sign in"
                        IsDefault="True"
                        Click="LoginButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
